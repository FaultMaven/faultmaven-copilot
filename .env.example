# FaultMaven Copilot - Environment Configuration
# Copy this file to .env.local and customize for your environment

# ============================================================================
# API Configuration
# ============================================================================

# Backend API endpoint (DEPRECATED - now derived from Dashboard URL)
# This is kept for backward compatibility during migration
# Extension now stores Dashboard URL and derives API URL from it
# Default: http://127.0.0.1:8090
#VITE_API_URL=http://127.0.0.1:8090

# ============================================================================
# Input Limits Configuration (Phase 1 Week 2)
# ============================================================================

# Smart Input Detection: Number of lines that triggers automatic data upload mode
# When user pastes text with >= this many lines, it's treated as data upload instead of question
# Default: 100 lines
# Range: 10-1000
#VITE_DATA_MODE_LINES=100

# Maximum Query Length: Maximum characters allowed in text input
# Default: 200000 characters (200KB, matches backend QueryRequest.query max_length)
# Range: 1000-200000
#VITE_MAX_QUERY_LENGTH=200000

# Maximum File Upload Size: Maximum file size in megabytes
# Default: 10 MB
# Range: 1-100 MB
#VITE_MAX_FILE_SIZE_MB=10

# ============================================================================
# How to Use These Variables
# ============================================================================
#
# 1. For local development:
#    - Copy this file: cp .env.example .env.local
#    - Uncomment and modify values as needed
#    - Restart dev server: pnpm dev
#
# 2. For production builds:
#    - Set environment variables before build:
#      export VITE_API_URL=https://api.production.com
#      export VITE_MAX_FILE_SIZE_MB=50
#      pnpm build
#
# 3. For CI/CD:
#    - Set as secrets/environment variables in your CI platform
#    - They'll be baked into the build at compile time
#
# Note: All VITE_* variables are replaced at BUILD TIME, not runtime.
# Changing .env.local requires restarting the dev server or rebuilding.

# ============================================================================
# Dashboard Configuration
# ============================================================================

# URL for the main dashboard (used for OAuth authentication)
# Local deployment: http://localhost:3333
# Cloud deployment: https://app.faultmaven.ai
# Default: http://localhost:3333
VITE_DASHBOARD_URL=http://localhost:3333

# ============================================================================
# Debugging
# ============================================================================

# Enable debug logging
# Default: false
VITE_DEBUG=false

# ============================================================================
# Polling Configuration
# ============================================================================

# Initial polling interval in ms
VITE_POLL_INITIAL_MS=1500

# Polling backoff multiplier
VITE_POLL_BACKOFF=1.5

# Maximum polling interval in ms
VITE_POLL_MAX_MS=10000

# Maximum total polling time in ms
VITE_POLL_MAX_TOTAL_MS=600000

# Session keep-alive heartbeat interval in ms. Must stay comfortably below the
# server's session inactivity TTL (default 30 min); lower this if you tune that TTL down.
VITE_HEARTBEAT_INTERVAL_MS=600000

# ============================================================================
# Pre-release identity (BUILD-TIME — not a runtime setting)
# ============================================================================

# FM_STORE_KEY - the Chrome Web Store item's public key. Setting it makes a local
# build take the PUBLISHED extension id, which is the only redirect FaultMaven
# Cloud's OAuth allowlist admits; without it an unpacked build cannot sign in
# there at all. Used to test a release candidate before it ships.
#
# Do NOT set it here, or in .env.local. Unlike everything else in this file it is
# read at BUILD time, and dotenv files are loaded into the build - so a value
# parked here pins the published identity into EVERY later build, including one
# you might upload. Pass it per invocation instead:
#
#     FM_STORE_KEY=<store item public key> pnpm build
