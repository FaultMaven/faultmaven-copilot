# Node dependencies
node_modules/

# WXT build output and cache
.output/
.wxt/
*.wxt.d.ts
output/

# Vite cache
node_modules/.vite/

# OS-specific
.DS_Store
Thumbs.db

# IDE-specific
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# Log files
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
yarn-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# PNPM
pnpm-lock.yaml # Or add this if you prefer not to commit the lockfile, though committing it is usually recommended for consistency.
                 # For libraries it's often not committed, for applications it often is. Your call.

# Test coverage reports
coverage/
*.lcov
.nyc_output/

# Temporary files
*.tmp
*.swp

# Git worktrees checked out under the repo (git worktree add .worktrees/<name>).
# Also excluded from vitest in vitest.config.ts — .gitignore alone would not stop
# the test runner collecting a second, stale copy of the suite.
.worktrees/

# Playwright artifacts
playwright-report/
test-results/

# Host-independence proof build output (playground/vite.config.ts)
playground/dist/

# Served from the package, not committed twice (scripts/sync-ui-assets.mjs).
public/icon/square-transparent.svg
public/icon/design-transparent.svg

# Standalone build output of the shared package (proves it compiles on its own).
packages/*/dist/
